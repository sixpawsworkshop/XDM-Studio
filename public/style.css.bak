/* CUSTOM CYBER aesthetic STYLES */

/* Ambient Grid Lines Background for Panels */
.grid-lines {
  background-image: linear-gradient(to right, rgba(0, 240, 255, 0.05) 1px, transparent 1px),
                    linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px);
  background-size: 20px 20px;
}

/* Glassmorphism Cyber Cards */
.cyber-panel {
  background-color: #121724;
  border: 1px solid #1f293d;
  box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.cyber-panel:hover {
  border-color: rgba(6, 182, 212, 0.25);
  box-shadow: 0 15px 35px -8px rgba(0, 0, 0, 0.8), 0 0 15px rgba(6, 182, 212, 0.05);
}

/* Scrollbar customization for dark-cyber theme */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #06080c;
  border-radius: 8px;
}

::-webkit-scrollbar-thumb {
  background: #1f293d;
  border-radius: 8px;
  border: 1px solid #121724;
}

::-webkit-scrollbar-thumb:hover {
  background: #06b6d4;
}

/* Active Function Button neon glows */
.func-btn {
  background-color: #0d111c;
  border-color: #1f293d;
  color: #9ca3af;
}

.func-btn:hover {
  color: #fff;
  border-color: rgba(6, 182, 212, 0.4);
  background-color: rgba(6, 182, 212, 0.03);
}

/* Specialized colors for selected active buttons */
.func-btn.active {
  background: linear-gradient(135deg, #162a3a 0%, #0c1524 100%);
  border-color: #06b6d4;
  color: #22d3ee;
  box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
}

/* Specific sub-color overrides for selected function buttons */
.func-btn.active[data-func*="VOLT AC"] {
  border-color: #38bdf8;
  color: #38bdf8;
  box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
}

.func-btn.active[data-func*="CURR"] {
  border-color: #f59e0b;
  color: #fbbf24;
  box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
}

.func-btn.active[data-func*="RES"], .func-btn.active[data-func*="FRES"] {
  border-color: #10b981;
  color: #34d399;
  box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
}

.func-btn.active[data-func*="CAP"] {
  border-color: #818cf8;
  color: #a5b4fc;
  box-shadow: 0 0 15px rgba(129, 140, 248, 0.2);
}

.func-btn.active[data-func*="FREQ"] {
  border-color: #3b82f6;
  color: #60a5fa;
  box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
}

.func-btn.active[data-func*="TEMP"] {
  border-color: #ef4444;
  color: #f87171;
  box-shadow: 0 0 15px rgba(239, 68, 68, 0.2);
}

.func-btn.active[data-func*="DIOD"] {
  border-color: #ec4899;
  color: #f472b6;
  box-shadow: 0 0 15px rgba(236, 72, 153, 0.2);
}

/* OLED display segment styling */
#mainReading {
  text-shadow: 0 0 10px rgba(34, 211, 238, 0.5), 0 0 20px rgba(34, 211, 238, 0.2);
}

#mainReading.ol-active {
  color: #ef4444 !important;
  text-shadow: 0 0 10px rgba(239, 68, 68, 0.6), 0 0 20px rgba(239, 68, 68, 0.3) !important;
}

#subReading {
  text-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
}

/* Active range & speed configurations indicators */
.speed-active {
  background-color: #06b6d4 !important;
  color: #06080c !important;
  box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
}

/* Custom slider style */
#sampleIntervalSlider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #06b6d4;
  cursor: pointer;
  box-shadow: 0 0 8px #06b6d4;
  transition: all 0.2s;
}

#sampleIntervalSlider::-webkit-slider-thumb:hover {
  background: #22d3ee;
  box-shadow: 0 0 12px #22d3ee;
  transform: scale(1.15);
}

/* Terminal logs coloring */
.terminal-tx {
  color: #9ca3af; /* raw output grey */
}
.terminal-tx::before {
  content: ">> ";
  color: #06b6d4;
}

.terminal-rx {
  color: #10b981; /* dynamic return values green */
  font-weight: 500;
}
.terminal-rx::before {
  content: "<< ";
  color: #34d399;
}

.terminal-err {
  color: #f87171; /* error handling red */
}
.terminal-err::before {
  content: "!! ";
  color: #ef4444;
}

/* Flashing visual alert animation */
@keyframes borderAlert {
  0% { border-color: rgba(239, 68, 68, 0.2); }
  50% { border-color: rgba(239, 68, 68, 0.8); box-shadow: 0 0 20px rgba(239, 68, 68, 0.4); }
  100% { border-color: rgba(239, 68, 68, 0.2); }
}

.border-alert-active {
  animation: borderAlert 1s infinite !important;
}

/* Status dots animations */
@keyframes blink {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}

.blink-dot {
  animation: blink 1.5s infinite;
}
